{
	"name": "n8n-nodes-jev",
	"version": "0.2.1",
	"description": "Helper n8n community node for Jev by TypeSafe: classify, route, and score text with questions you define, and get a probability for every answer.",
	"license": "MIT",
	"homepage": "https://github.com/vibe-with-me-tools/n8n-nodes-jev#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"n8n-node",
		"jev",
		"typesafe",
		"classification",
		"text-classification",
		"routing",
		"triage",
		"moderation",
		"guardrails",
		"workflow-automation"
	],
	"author": {
		"name": "Brains of Bots",
		"email": "mjsadiq@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vibe-with-me-tools/n8n-nodes-jev.git"
	},
	"bugs": {
		"url": "https://github.com/vibe-with-me-tools/n8n-nodes-jev/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p test/tsconfig.json",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/docs",
		"!dist/**/*.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/JevApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Jev/Jev.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "5.0.1"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
